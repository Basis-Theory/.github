{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Basis Theory org-wide Renovate config preset",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "timezone": "America/New_York",
  "schedule": ["before 6am on monday"],
  "automerge": false,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 5,
  "minimumReleaseAge": "7 days",
  "configMigration": true,
  "labels": ["dependencies"],
  "enabledManagers": ["npm", "nuget", "dockerfile", "github-actions", "terraform"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "1 day",
    "labels": ["dependencies", "security"]
  },
  "packageRules": [
    {
      "description": "Group all non-major updates into a single PR",
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "description": "Require Dependency Dashboard approval before opening major update PRs",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
